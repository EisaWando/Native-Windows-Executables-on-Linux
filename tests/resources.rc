#include <windows.h>
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
101 MENU
BEGIN
 POPUP "&File"
 BEGIN
  MENUITEM "&Open", 40001
  MENUITEM SEPARATOR
  MENUITEM "E&xit", 40002
 END
 POPUP "&Help"
 BEGIN
  MENUITEM "&About", 40003
 END
END
102 ACCELERATORS
BEGIN
 "O", 40001, VIRTKEY, CONTROL
END
STRINGTABLE
BEGIN
 17 "resource text"
END
