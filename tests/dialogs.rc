#include <windows.h>
101 DIALOG 0,0,160,100
STYLE WS_POPUP | WS_CAPTION | DS_SETFONT
CAPTION "Test Dialog"
FONT 9,"DejaVu Sans"
BEGIN
 LTEXT "Label",101,5,5,45,10
 EDITTEXT 102,5,20,70,12,WS_TABSTOP
 CONTROL "Check",103,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,36,55,10
 CONTROL "One",104,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,5,50,50,10
 CONTROL "Two",105,"Button",BS_AUTORADIOBUTTON,5,62,50,10
 DEFPUSHBUTTON "OK",IDOK,70,80,40,14
 PUSHBUTTON "Cancel",IDCANCEL,115,80,40,14
END
